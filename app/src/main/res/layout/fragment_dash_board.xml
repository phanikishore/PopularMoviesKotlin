<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.fragment.DashBoardFragment">

        <com.kishore.tmdbapp.ui.widget.CategoryView
            android:id="@+id/popularMovies"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:categoryName="Popular Movies"
            app:categoryTextSize="8sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.kishore.tmdbapp.ui.widget.CategoryView
            android:id="@+id/topMovies"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:categoryName="Top Rated"
            app:categoryTextSize="8sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/popularMovies" />

        <com.kishore.tmdbapp.ui.widget.CategoryView
            android:id="@+id/tvshows"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:categoryName="TV Shows"
            app:categoryTextSize="8sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topMovies" />
</androidx.constraintlayout.widget.ConstraintLayout>
